{
  "name": "story-video-desktop",
  "version": "0.6.0",
  "private": true,
  "description": "面向 Intel Mac 的本地分镜视频客户端",
  "main": "dist-main/main/index.js",
  "scripts": {
    "dev": "tsc -p tsconfig.main.json && node scripts/dev.mjs",
    "check:main": "tsc -p tsconfig.main.json --noEmit",
    "check:renderer": "tsc -p tsconfig.renderer.json --noEmit",
    "check:tests": "tsc -p tsconfig.tests.json",
    "lint": "eslint src scripts vite.config.ts eslint.config.mjs",
    "test:export": "tsx --test src/main/exporter.test.ts",
    "test:ai": "tsx --test src/main/ai/client.test.ts src/main/ai/settings-store.test.ts",
    "test:ai-desktop": "tsc -p tsconfig.main.json && tsx scripts/smoke-ai.ts",
    "test:images": "tsx --test src/main/ai/image-client.test.ts",
    "test:images-desktop": "tsc -p tsconfig.main.json && tsx scripts/smoke-images.ts",
    "test:speech": "tsx --test src/main/ai/speech-client.test.ts src/main/speech-export.test.ts",
    "test:speech-desktop": "tsc -p tsconfig.main.json && tsx scripts/smoke-speech.ts",
    "test:captions": "tsx --test src/shared/captions.test.ts src/main/captions-export.test.ts",
    "test:captions-desktop": "tsc -p tsconfig.main.json && tsx scripts/smoke-captions.ts",
    "test:recovery": "tsx --test src/main/recovery-store.test.ts",
    "test:hardening": "tsx --test src/shared/task-control.test.ts src/shared/project-integrity.test.ts",
    "test:hardening-desktop": "tsx scripts/smoke-hardening.ts",
    "test:media": "tsx --test src/main/media-check.test.ts",
    "test:media-desktop": "tsx scripts/smoke-media.ts",
    "test:relink-text": "tsx --test src/main/artifact-relink.test.ts src/shared/text-plan.test.ts src/main/ai/segments.test.ts",
    "test:relink-text-desktop": "tsx scripts/smoke-relink-text.ts",
    "test:recovery-desktop": "tsc -p tsconfig.main.json && tsx scripts/smoke-recovery.ts",
    "test:desktop": "tsc -p tsconfig.main.json && tsx scripts/smoke-desktop.ts",
    "demo:export": "tsx scripts/smoke-export.ts",
    "build": "tsc -p tsconfig.main.json && vite build",
    "package:mac": "npm run build && electron-builder --mac dmg --x64"
  },
  "dependencies": {
    "ffmpeg-static": "^5.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.34.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.4.0",
    "electron": "^45.3.0",
    "electron-builder": "^26.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.0.0",
    "playwright-core": "^1.58.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^6.2.0"
  },
  "build": {
    "appId": "local.storyvideo.desktop",
    "productName": "映序",
    "directories": { "output": "release" },
    "files": ["dist/**", "dist-main/**", "package.json"],
    "asarUnpack": ["node_modules/ffmpeg-static/**", "node_modules/sharp/**", "node_modules/@img/**"],
    "mac": { "target": [{ "target": "dmg", "arch": ["x64"] }], "category": "public.app-category.video" }
  }
}
